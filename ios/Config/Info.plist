<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Rides: keep tracking and speak the arrival answer with the phone locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<!-- The Lock Screen / Dynamic Island view of a ride and of directions to a dock. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMotionUsageDescription</key>
	<string>Dock Finder checks whether you're biking, so it only tells you where to dock when you ride up to a saved place, not when you walk or take the subway.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Dock Finder tells you where to dock as you get close, and guides you there turn by turn, with your phone locked in your pocket. If you choose to share usage data, where you were is included.</string>
	<key>DockFinderBackendHost</key>
	<string>$(DOCKFINDER_BACKEND_HOST)</string>
	<key>DockFinderMetricsURL</key>
	<string>$(DOCKFINDER_METRICS_URL)</string>
	<!-- "Dock" and "doc" sound the same, so Siri often transcribes the app's
	     name as "Doc Finder". These names let Siri match it anyway. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Doc Finder</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>dock finder</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Dockfinder</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>dock finder</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Docks Finder</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>docks finder</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Dog Finder</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>dock finder</string>
		</dict>
	</array>
</dict>
</plist>
